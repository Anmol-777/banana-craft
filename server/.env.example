# Server Environment Configuration - Production
# Copy to .env and fill in your values

# Required
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# Server
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# CORS - Add your Vercel frontend URL here (comma-separated, no trailing slashes)
CORS_ORIGINS=https://your-app.vercel.app

# Public URL of your deployed API (e.g., Railway/Render URL)
PUBLIC_URL=https://your-api.railway.app

# Admin Bootstrap (creates initial admin user on first start)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-random-password-here
ADMIN_USERNAME=admin
ADMIN_NAME=Site Admin

# Optional
# MAX_UPLOAD_MB=5
# BCRYPT_ROUNDS=12
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10